@model IEnumerable<Application.RestaurantDto.RestaurantDto>

@{
    ViewData["Title"] = "Zarządzanie restauracjami";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Panel Administratora</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Restauracje</li>
                </ol>
            </nav>
            <h1 class="display-5">
                <i class="bi bi-shop"></i> Zarządzanie restauracjami
            </h1>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Wszystkie restauracje w systemie (@Model.Count())</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var restaurant in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="bi bi-shop"></i>
                                        @restaurant.Name
                                    </h5>
                                    <p class="card-text text-muted small">
                                        @(string.IsNullOrEmpty(restaurant.Description)
                                            ? "Brak opisu"
                                            : (restaurant.Description.Length > 100
                                                ? restaurant.Description.Substring(0, 100) + "..."
                                                : restaurant.Description))
                                    </p>
                                    <hr />
                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <i class="bi bi-tag"></i> Kategoria:
                                        </small>
                                        <span class="badge bg-secondary">@restaurant.Category</span>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <i class="bi bi-geo-alt"></i>
                                            @restaurant.City, @restaurant.Street
                                        </small>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <i class="bi bi-envelope"></i>
                                            @restaurant.ContactEmail
                                        </small>
                                    </div>
                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <i class="bi bi-telephone"></i>
                                            @restaurant.ContactNumber
                                        </small>
                                    </div>
                                    @if (restaurant.HasDelivery)
                                    {
                                        <div class="mb-2">
                                            <span class="badge bg-success">
                                                <i class="bi bi-truck"></i> Dostawa
                                            </span>
                                        </div>
                                    }
                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <i class="bi bi-egg-fried"></i>
                                            Liczba dań: <strong>@restaurant.Dishes.Count</strong>
                                        </small>
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent">
                                    <a asp-controller="Restaurant" asp-action="Details"
                                       asp-route-encodedName="@restaurant.EncodedName"
                                       class="btn btn-sm btn-primary w-100">
                                        <i class="bi bi-eye"></i> Zobacz szczegóły
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i>
                    Brak restauracji w systemie.
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Powrót do panelu
        </a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
