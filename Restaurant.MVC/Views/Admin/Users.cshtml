@model IEnumerable<Application.AdminDto.UserDto>

@{
    ViewData["Title"] = "Zarządzanie użytkownikami";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Panel Administratora</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Użytkownicy</li>
                </ol>
            </nav>
            <h1 class="display-5">
                <i class="bi bi-people"></i> Zarządzanie użytkownikami
            </h1>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Lista użytkowników (@Model.Count())</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Imię i nazwisko</th>
                            <th>Status</th>
                            <th>Role</th>
                            <th>Restauracje</th>
                            <th class="text-center">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <i class="bi bi-envelope"></i>
                                    @user.Email
                                    @if (user.EmailConfirmed)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Email potwierdzony"></i>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.FirstName) || !string.IsNullOrEmpty(user.LastName))
                                    {
                                        <span>@user.FirstName @user.LastName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-success">Aktywny</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Niepotwierdzony</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Roles.Any())
                                    {
                                        foreach (var role in user.Roles)
                                        {
                                            <span class="badge @(role == "Administrator" ? "bg-danger" : "bg-info")">
                                                @role
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">User</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary">@user.RestaurantsCount</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <form asp-action="ToggleAdminRole" method="post" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.Roles.Contains("Administrator"))
                                            {
                                                <button type="submit" class="btn btn-warning" title="Odbierz rolę administratora">
                                                    <i class="bi bi-shield-minus"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-success" title="Nadaj rolę administratora">
                                                    <i class="bi bi-shield-plus"></i>
                                                </button>
                                            }
                                        </form>
                                        <form asp-action="DeleteUser" method="post" class="d-inline"
                                              onsubmit="return confirm('Czy na pewno chcesz usunąć użytkownika @user.Email? Ta operacja jest nieodwracalna.');">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            <button type="submit" class="btn btn-danger" title="Usuń użytkownika">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Powrót do panelu
        </a>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
