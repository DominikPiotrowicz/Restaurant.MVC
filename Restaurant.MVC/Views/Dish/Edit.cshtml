@model Application.DishDto.Commands.EditDish.EditDishCommand

@{
    ViewData["Title"] = "Edytuj danie";
}

<div class="container">
    <h2 class="my-4">Edytuj danie</h2>

    <form method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Nazwa dania</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Opis</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Cena (zł)</label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label">Kategoria</label>
            <select asp-for="Category" class="form-select" asp-items="Html.GetEnumSelectList<Domain.Enums.DishCategory>()">
                <option value="">-- Wybierz kategorię --</option>
            </select>
            <span asp-validation-for="Category" class="text-danger"></span>
        </div>

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="RestaurantEncodedName" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
            <a asp-controller="Restaurant" asp-action="Details" asp-route-encodedName="@Model.RestaurantEncodedName" class="btn btn-secondary">Anuluj</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
