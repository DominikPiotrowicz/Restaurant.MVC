@using Application.Extensions
@model Application.RestaurantDto.RestaurantDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-4">
    <div class="row">
        <div class="col-md-8">
            <h1 class="mb-3">@Model.Name</h1>

            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Informacje o restauracji</h5>
                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Opis</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Kategoria</dt>
                        <dd class="col-sm-8">@Model.Category</dd>

                        <dt class="col-sm-4">Dostawa</dt>
                        <dd class="col-sm-8">
                            @if (Model.HasDelivery)
                            {
                                <span class="badge bg-success">Tak</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Nie</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Adres</dt>
                        <dd class="col-sm-8">
                            @Model.Street<br />
                            @Model.PostalCode @Model.City
                        </dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            <a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a>
                        </dd>

                        <dt class="col-sm-4">Telefon</dt>
                        <dd class="col-sm-8">
                            <a href="tel:@Model.ContactNumber">@Model.ContactNumber</a>
                        </dd>
                    </dl>

                    <div class="mt-3">
                        <a asp-action="Edit" asp-route-encodedName="@Model.EncodedName" class="btn btn-primary">Edytuj restaurację</a>
                        <a asp-action="Index" class="btn btn-secondary">Powrót do listy</a>
                    </div>
                </div>
            </div>

            <!-- Sekcja menu (dań) -->
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Menu</h5>
                    <a asp-controller="Dish" asp-action="Create" asp-route-restaurantEncodedName="@Model.EncodedName" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-circle"></i> Dodaj danie
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Dishes != null && Model.Dishes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Nazwa</th>
                                        <th>Kategoria</th>
                                        <th>Opis</th>
                                        <th class="text-end">Cena</th>
                                        <th class="text-end">Akcje</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dish in Model.Dishes)
                                    {
                                        <tr>
                                            <td><strong>@dish.Name</strong></td>
                                            <td><span class="badge bg-info">@dish.Category.ToPolishString()</span></td>
                                            <td>@dish.Description</td>
                                            <td class="text-end">@dish.Price.ToString("C", new System.Globalization.CultureInfo("pl-PL"))</td>
                                            <td class="text-end">
                                                <a asp-controller="Dish" asp-action="Edit"
                                                   asp-route-restaurantEncodedName="@Model.EncodedName"
                                                   asp-route-dishId="@dish.Id"
                                                   class="btn btn-sm btn-outline-primary">
                                                    Edytuj
                                                </a>
                                                <form asp-controller="Dish" asp-action="Delete"
                                                      asp-route-restaurantEncodedName="@Model.EncodedName"
                                                      asp-route-dishId="@dish.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Czy na pewno chcesz usunąć to danie?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        Usuń
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <p>Brak dań w menu.</p>
                            <a asp-controller="Dish" asp-action="Create" asp-route-restaurantEncodedName="@Model.EncodedName" class="btn btn-primary">
                                Dodaj pierwsze danie
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
