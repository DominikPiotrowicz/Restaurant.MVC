@model IEnumerable<Application.RestaurantDto.RestaurantDto>

@{
    ViewData["Title"] = "Restauracje";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Restauracje</h1>
        <a asp-action="Create" class="btn btn-success">Dodaj restaurację</a>
    </div>

    <!-- Formularz wyszukiwania i filtrów -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Wyszukaj</label>
                        <input type="text" name="searchPhrase" class="form-control" placeholder="Nazwa lub opis..." value="@ViewBag.SearchPhrase" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Kategoria</label>
                        <select name="category" class="form-select">
                            <option value="">Wszystkie</option>
                            <option value="Fast Food" selected="@(ViewBag.Category == "Fast Food")">Fast Food</option>
                            <option value="Włoska" selected="@(ViewBag.Category == "Włoska")">Włoska</option>
                            <option value="Polska" selected="@(ViewBag.Category == "Polska")">Polska</option>
                            <option value="Azjatycka" selected="@(ViewBag.Category == "Azjatycka")">Azjatycka</option>
                            <option value="Wegetariańska" selected="@(ViewBag.Category == "Wegetariańska")">Wegetariańska</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Dostawa</label>
                        <select name="hasDelivery" class="form-select">
                            <option value="">Wszystkie</option>
                            <option value="true" selected="@(ViewBag.HasDelivery == true)">Tak</option>
                            <option value="false" selected="@(ViewBag.HasDelivery == false)">Nie</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">Szukaj</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.SearchPhrase as string) || !string.IsNullOrEmpty(ViewBag.Category as string) || ViewBag.HasDelivery != null)
                {
                    <div class="mt-3">
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Wyczyść filtry</a>
                    </div>
                }
            </form>
        </div>
    </div>

    <!-- Lista restauracji -->
    @if (Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-muted">@item.Description</p>
                            <div class="mb-2">
                                <span class="badge bg-secondary">@item.Category</span>
                                @if (item.HasDelivery)
                                {
                                    <span class="badge bg-success">Dostawa</span>
                                }
                            </div>
                            <p class="card-text small">
                                <i class="bi bi-geo-alt"></i> @item.City, @item.Street
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex gap-2">
                                <a class="btn btn-primary btn-sm flex-fill" asp-action="Details" asp-route-encodedName="@item.EncodedName">
                                    Szczegóły
                                </a>
                                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-encodedName="@item.EncodedName">
                                    Edytuj
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center">
            <h4>Brak restauracji</h4>
            <p>Nie znaleziono restauracji spełniających kryteria wyszukiwania.</p>
            <a asp-action="Index" class="btn btn-primary">Pokaż wszystkie</a>
        </div>
    }
</div>
