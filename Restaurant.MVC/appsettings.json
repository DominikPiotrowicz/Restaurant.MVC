{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": { "Restaurant": "Server=(localdb)\\mssqllocaldb;Database=RestaurantDb;Trusted_Connection=True;" },
  "AllowedHosts": "*",
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 1000
      },
      {
        "Endpoint": "*/Account/Login",
        "Period": "5m",
        "Limit": 10
      },
      {
        "Endpoint": "*/Account/Register",
        "Period": "1h",
        "Limit": 5
      }
    ]
  }
}
